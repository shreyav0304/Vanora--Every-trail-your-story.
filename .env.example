PORT=5173
# Public community map-data endpoint; no API key required. Searches can be unavailable.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional. Without this, preparation uses a clearly labelled deterministic checklist.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set true only behind an HTTPS reverse proxy.
COOKIE_SECURE=false
# Hosted backend (keep these server-side; Vercel Functions read them).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Production site URL, also add it to Supabase Auth redirect URLs.
APP_URL=
# Set to supabase for a cloud build. Leave blank for the local SQLite MVP.
VITE_AUTH_BACKEND=
